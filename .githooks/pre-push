#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if [[ -n "$(git status --porcelain)" ]]; then
  printf '%s\n' 'Push interrompido: faça commit ou preserve as alterações antes de validar o commit enviado.' >&2
  exit 1
fi
HEAD_SHA="$(git rev-parse HEAD)"
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" != 0000000000000000000000000000000000000000 && "$local_sha" != "$HEAD_SHA" ]]; then
    printf '%s\n' 'Envie apenas o commit atualmente em checkout para garantir a validação do conteúdo enviado.' >&2
    exit 1
  fi
done
exec backend/.venv/bin/python scripts/validate.py
